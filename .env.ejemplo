# ==========================================================================
# ICEWELL — configuración para Docker (producción)
# Copiar a .env (NO va a git) y completar. En la PC no hace falta: usar docker-compose.dev.yml.
# ==========================================================================

ICEWELL_ENTORNO=produccion

# Dirección pública, https y sin barra final. Se usa en los enlaces de los correos.
ICEWELL_URL_BASE=https://www.icewell.cl
# Para el certificado HTTPS automático (perfil "https", Caddy). El DNS debe apuntar al servidor.
ICEWELL_DOMINIO=www.icewell.cl

# Secretos: generar CADA UNO con   openssl rand -hex 32
# (o: docker run --rm php:8.3-cli php -r "echo bin2hex(random_bytes(32)), PHP_EOL;")
# ⚠ NO cambiarlos después: el pepper invalida todas las contraseñas y la clave de cifrado los 2FA.
ICEWELL_PEPPER=
ICEWELL_CLAVE_CIFRADO=

# Base de datos (la crea el contenedor "db" la primera vez)
ICEWELL_BD_NOMBRE=icewell
ICEWELL_BD_USUARIO=icewell
ICEWELL_BD_CLAVE=

# Quién puede entrar
ICEWELL_DOMINIOS=icewell.cl
# Este correo queda admin al confirmar su cuenta (primer acceso). Vaciar cuando ya exista un admin.
ICEWELL_ADMIN_INICIAL=
# admin = solo administradores publican | editor = cualquier usuario aprobado publica
ICEWELL_PUBLICAR_ROL=admin

# Entrar con Google (opcional): ID de cliente OAuth "Aplicación web", origen = ICEWELL_URL_BASE
ICEWELL_GOOGLE_CLIENT_ID=

# Correo saliente (SMTP de la empresa). Google Workspace: smtp.gmail.com, 587, tls,
# clave = "contraseña de aplicación" de esa cuenta.
ICEWELL_SMTP_HOST=smtp.gmail.com
ICEWELL_SMTP_PUERTO=587
ICEWELL_SMTP_SEGURIDAD=tls
ICEWELL_SMTP_USUARIO=no-responder@icewell.cl
ICEWELL_SMTP_CLAVE=
ICEWELL_SMTP_DE=no-responder@icewell.cl

# Proxies a los que se les cree X-Forwarded-Proto / X-Forwarded-For (IPs o rangos CIDR).
# Por defecto, la red interna de Docker (Caddy). Si hay Cloudflare delante, agregar sus rangos.
ICEWELL_PROXIES_CONFIABLES=172.16.0.0/12
